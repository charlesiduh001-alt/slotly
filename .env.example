# Copy to .env.local and fill in.
# Local SQLite file, or a Turso URL (libsql://...) in production.
DATABASE_URL=file:local.db
# Only needed for Turso.
DATABASE_AUTH_TOKEN=
# Password for /admin.
ADMIN_PASSWORD=change-me
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
